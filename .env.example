# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Web3Forms (lead form submissions)
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Invoices admin password (gates the /invoices page)
VITE_INVOICE_PASSWORD=change-me

# Supabase — invoice cloud storage.
# From your Supabase project: Project Settings → API
#   URL  = "Project URL"
#   KEY  = "anon" / "public" key  (NOT the service_role key)
# Leave these blank to run in localStorage-only mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
